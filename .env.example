# Copy this file to .env and fill in real values.

PORT=3000

# Administrator sign-in for /admin. CHANGE THESE before going live.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Where the SQLite database and uploaded aspirant photos are stored.
DATA_DIR=./data

# Set to true when serving over HTTPS so session cookies are marked Secure.
SECURE_COOKIES=false
